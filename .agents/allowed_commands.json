{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Allowed and blocked commands configuration for Antigravity agents in OrganizadorCursada",
  "defaultDecision": "ask",
  "exact": [
    "git status",
    "git diff",
    "npm test",
    "ng serve",
    "ng build",
    "ng test",
    "npm run build",
    "npm run config:env",
    "npm run test:e2e",
    "npm run test:e2e:ui",
    "npm run test:e2e:debug",
    "npm run docker:up",
    "npm run docker:down",
    "npm run docker:build",
    "npm run qa:audit",
    "npm run qa:verify",
    "npm run ticket:new",
    "npm run ticket:status",
    "npm run gitflow:branch",
    "npm run gitflow:commit",
    "npm run gitflow:pr",
    "npm run gen:service"
  ],
  "prefixes": [
    "ng ",
    "npm ",
    "npx ",
    "node ",
    "git status",
    "git diff",
    "git log",
    "git branch",
    "git checkout",
    "git add ",
    "git commit ",
    "git stash",
    "git merge ",
    "git rebase ",
    "git fetch",
    "git pull",
    "docker compose ",
    "docker "
  ],
  "blockedPrefixes": [
    "rm -rf",
    "rmdir /s",
    "del /f",
    "git push --force",
    "git push -f",
    "git reset --hard",
    "format "
  ]
}
